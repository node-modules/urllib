{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/index.ts", "examples/*.mjs", "test/{mts/src,fixtures/ts-esm}/**/*.{ts,mts}", "test/**/*.bench.ts"],
  "ignoreDependencies": [
    // Oxlint loads this plugin through lint.jsPlugins in vite.config.ts.
    "@e18e/eslint-plugin",
    // scripts/tsrs.js selects and imports the compiler dynamically for each platform.
    "@ts-rs/wasm",
    "tsrs",
  ],
}
