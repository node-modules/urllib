{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": ["src/index.ts", "examples/*.mjs", "test/{mts/src,fixtures/ts-esm}/**/*.{ts,mts}"],
  // The project uses tsrs, so the TypeScript plugin needs to be enabled explicitly.
  "typescript": true,
  // scripts/tsrs.js selects and imports the compiler dynamically for each platform.
  "ignoreDependencies": ["@ts-rs/wasm", "tsrs"],
}
